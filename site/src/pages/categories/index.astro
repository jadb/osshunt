---
import Avatars from '../../components/Avatars.astro';
import Page from '../../layouts/Page.astro';
import { categoriesIndex, REACH_LABEL } from '../../lib/compare';
const { groups } = await categoriesIndex();
const total = groups.reduce((n, g) => n + g.items.length, 0);
---
<Page title="Categories of paid software | OSSHunt" description={`${total} categories of business software, ordered by editorial audience reach.`}>
  <main id="main" class="wrap cats">
    <h1>Categories</h1>
    <p class="lede">{total} categories, ordered by editorial audience reach. Audience position is an estimate, not a measured market size.</p>
    {groups.map((g) => (
      <details class="sec group" open>
        <summary><h2 id={`r-${g.reach}`}>{REACH_LABEL[g.reach]}</h2></summary>
        <ul>
          {g.items.map((c) => (
            <li>
              <a href={`/categories/${c.id}/`}><b>{c.name}</b><span>{c.tools} tool{c.tools === 1 ? '' : 's'} · {c.maps} mapping{c.maps === 1 ? '' : 's'}</span><em>{c.description}</em>
                <span class="flow"><Avatars items={c.toolList} max={4} />{c.altList.length > 0 && <svg class="arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-label="replaced by" role="img"><path d="M3 12h16M13 6l6 6-6 6" /></svg>}<Avatars items={c.altList} max={4} /></span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </main>
</Page>

<style>
  .cats { padding-block: 32px 64px; }
  h1 { font-size: clamp(2.25rem, 5vw, 4rem); font-family: var(--display); font-weight: 900; line-height: 1; }
  .lede { color: var(--ink-2); margin: 10px 0 8px; max-width: 70ch; }
  .sec > summary { margin-top: 36px; padding-bottom: 6px; }
  .sec > ul { border-top: 3px solid var(--ink); }
  .sec > summary h2 { border: 0; margin: 0; padding: 0; }
  h2 { display: block; font-size: 1.0625rem; font-family: var(--display); font-weight: 900; text-transform: uppercase; border-bottom: 3px solid var(--ink); padding-bottom: 6px; margin: 36px 0 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); border-left: 1px solid var(--ink); }
  li { border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  li a { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; text-decoration: none; height: 100%; }
  li b { font-size: 1.0625rem; }
  li span { font-size: 0.8125rem; font-weight: 700; }
  .flow { display: flex; align-items: center; gap: 10px; margin-top: auto; padding-top: 12px; }
  .flow .arrow { flex: none; }
  li em { font-style: normal; font-size: 0.8125rem; color: var(--ink-2); }
</style>
