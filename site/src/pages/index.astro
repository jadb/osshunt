---
import Page from '../layouts/Page.astro';
import HeroLoop from '../components/HeroLoop.astro';
import Avatars from '../components/Avatars.astro';
import ToolSearch from '../components/ToolSearch.astro';
import { homeData, CHECKED } from '../lib/home';

const d = await homeData();
const REACH: Record<string, string> = {
  universal: 'Universal reach', broad: 'Broad reach', functional: 'Functional reach', specialist: 'Specialist reach',
};
---
<Page title="OSSHunt: open-source alternatives to software you pay for" description={`Sourced comparisons for ${d.counts.paid} paid tools: fit, license, price and risk, with unknowns shown. Checked ${CHECKED}.`}>

  <main id="main">
    <section class="hero wrap" aria-labelledby="h1">
      <div class="hero-copy">
        <h1 id="h1">Find the open-source alternative to what you pay for</h1>
        <ToolSearch tools={d.search} />
        <div class="samples" role="group" aria-label="Sample comparisons">
          <span class="slabel">See a sample <button type="button" class="stop" data-stop>Stop auto-rotating</button></span>
          {d.scenes.map((s, i) => <button type="button" class="chip" data-chip={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.name}</button>)}
        </div>
        <p class="lede">Sourced comparisons for {d.counts.paid} paid tools. Every mapping shows fit, license, tier and what we could not verify.</p>
      </div>
      <HeroLoop scenes={d.scenes} />
    </section>

    <div class="serving-band">
      <p class="serving wrap">
        <span><b>{d.counts.paid}</b> paid tools</span>
        <span><b>{d.counts.oss}</b> open-source and source-available candidates</span>
        <span><b>{d.counts.maps}</b> sourced mappings</span>
        <span><b>{d.counts.cats}</b> categories</span>
        <span>Checked <b>{CHECKED}</b></span>
      </p>
    </div>

    <section class="block wrap" aria-labelledby="price-h">
      <h2 id="price-h"><span>Entry prices, highest-reach categories first</span></h2>
      <ul class="prices">
        {d.prices.map((p) => (
          <li>
            <a class="pn" href={`/software/${p.id}/`}>{p.name}</a>
            <span class="pv">{p.price}{p.yearly && <em>billed yearly</em>}</span>
            <span class="pa">{p.alts} alternative{p.alts === 1 ? '' : 's'}</span>
            <a class="ps" href={p.source} aria-label={`${p.name} pricing page`}>Source</a>
          </li>
        ))}
      </ul>
      <p class="note">Lowest published per-seat price as checked on {CHECKED}; plans and minimums differ. Shown in the unit each vendor publishes, not converted. A price is not a cost comparison.</p>
    </section>

    <section class="block wrap" id="categories" aria-labelledby="cat-h">
      <h2 id="cat-h"><span>Browse by category</span><span class="meta">Ordered by editorial audience reach</span></h2>
      {d.groups.map((g) => (
        <details class="reach group" open>
          <summary><h3>{REACH[g.reach]}</h3></summary>
          <ul>
            {g.items.map((c) => <li><a href={`/categories/${c.id}/`}><span class="cname">{c.name}<span class="n">{c.paid} paid</span></span><span class="flow"><Avatars items={c.toolList} max={4} />{c.altList.length > 0 && <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-label="replaced by" role="img"><path d="M3 12h16M13 6l6 6-6 6" /></svg>}<Avatars items={c.altList} max={4} /></span></a></li>)}
          </ul>
        </details>
      ))}
      <p class="note">Audience position is an editorial estimate, not a measured market size.</p>
    </section>
  </main>

</Page>

<style>

  .hero { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); gap: clamp(28px, 5vw, 72px); padding-block: clamp(32px, 5vw, 64px); align-items: start; }
  h1 { font-size: clamp(2.5rem, 5.6vw, 5rem); line-height: 0.96; font-family: var(--display); font-weight: 900; letter-spacing: -0.005em; margin-bottom: 28px; }
  .samples { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 14px; font-weight: 700; font-size: 0.8125rem; }
  .slabel { flex-basis: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .stop { font: 600 0.75rem/1 'Archivo', sans-serif; background: none; border: 0; border-bottom: 2px solid var(--ink); padding: 2px 0; cursor: pointer; color: var(--ink); }
  .stop:hover { background: var(--band); }
  .stop[hidden] { display: none; }
  .chip { font: 700 0.8125rem/1 'Archivo', sans-serif; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); padding: 8px 10px; cursor: pointer; }
  .chip:hover { background: var(--band); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .lede { max-width: 56ch; margin: 22px 0 0; font-size: 1.0625rem; color: var(--ink-2); }

  .serving-band { border-top: var(--rule-3) solid var(--ink); border-bottom: var(--rule-1) solid var(--ink); }
  .serving { display: flex; flex-wrap: wrap; gap: 6px 28px; margin-block: 0; padding-block: 14px; font-size: 0.9375rem; }
  .serving b { font-weight: 900; font-size: 1.125rem; }

  .block { padding-block: clamp(32px, 4vw, 56px) 0; }
  h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; font-size: 1.125rem; font-family: var(--display); font-weight: 900; text-transform: uppercase; letter-spacing: 0.02em; border-bottom: var(--rule-3) solid var(--ink); padding-bottom: 6px; margin-bottom: 4px; }
  h2 a, h2 .meta { font-size: 0.875rem; font-weight: 600; text-transform: none; letter-spacing: 0; }
  .prices { list-style: none; margin: 0; padding: 0; border-left: 3px solid var(--ink); border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink); }
  .prices li { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 2.4fr) minmax(0, 1.4fr) auto; gap: 4px 16px; align-items: baseline; padding: 9px 14px; border-top: 1px solid var(--ink); }
  .prices li:first-child { border-top: 0; }
  .pn { font-weight: 800; }
  .pv em { display: inline-block; margin-left: 8px; font-size: 0.75rem; font-style: italic; color: var(--ink-2); }
  .pa { color: var(--ink-2); font-size: 0.875rem; }
  .ps { font-size: 0.875rem; }
  .note { font-size: 0.8125rem; color: var(--ink-2); margin: 10px 0 0; max-width: 70ch; }

  .reach { margin-top: 20px; }
  .reach > summary { padding: 4px 0; margin-bottom: 6px; }
  h3 { font-size: 1.125rem; font-family: var(--display); font-weight: 900; text-transform: uppercase; letter-spacing: 0.02em; margin-bottom: 6px; }
  .reach ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); border-top: var(--rule-3) solid var(--ink); border-left: var(--rule-1) solid var(--ink); }
  .reach li { border-right: var(--rule-1) solid var(--ink); border-bottom: var(--rule-1) solid var(--ink); }
  .reach a { display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; text-decoration: none; font-weight: 600; height: 100%; }
  .cname { display: flex; justify-content: space-between; gap: 12px; }
  .cname > .n { font-weight: 600; font-size: 0.75rem; color: var(--ink-2); white-space: nowrap; align-self: baseline; }
  .flow { display: flex; align-items: center; gap: 8px; margin-top: auto; min-height: 32px; }


  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .prices li { grid-template-columns: minmax(0, 1fr) auto; }
    .pv { grid-column: 1; } .pa { grid-column: 1; } .ps { grid-column: 2; grid-row: 1; }
  }
</style>
