---
import Page from '../layouts/Page.astro';
import HeroLoop from '../components/HeroLoop.astro';
import Avatars from '../components/Avatars.astro';
import ToolSearch from '../components/ToolSearch.astro';
import Headline from '../components/Headline.astro';
import Waitlist from '../components/Waitlist.astro';
import { homeData, CHECKED } from '../lib/home';
import { HEADLINE_CONTROL, STACK } from '../lib/brand-stack';

const d = await homeData();
const REACH: Record<string, string> = {
  universal: 'Universal reach', broad: 'Broad reach', functional: 'Functional reach', specialist: 'Specialist reach',
};
---
<Page title="OSSHunt: open-source alternatives to software you pay for" description={`Sourced comparisons for ${d.counts.paid} paid tools: fit, license, price and risk, with unknowns shown. Checked ${CHECKED}.`}>

  <main id="main">
    <div class="first">
    <section class="hero wrap" aria-labelledby="h1">
      <div class="hero-copy">
        <h1 id="h1" data-headline data-experiment={STACK.headlineExperiment} data-control={HEADLINE_CONTROL}>{HEADLINE_CONTROL}</h1>
        <Headline />
        <ToolSearch tools={d.search} />
        <div class="samples" role="group" aria-label="Sample comparisons">
          <span class="slabel">Samples:</span>
          <div class="chips" data-chips>
          {d.scenes.map((s, i) => <a class="chip dtip" href={`/software/${s.id}/`} data-chip={s.id} data-tip={s.name} aria-label={`${s.name}: see alternatives`} data-on={i === 0 ? '' : undefined}>{s.logo ? <img src={`/logos/${s.logo}.svg`} alt="" width="26" height="26" /> : s.chip}</a>)}
          </div>
        </div>
      </div>
      <HeroLoop scenes={d.scenes} />
    </section>

    <div class="stats-band" data-stats>
      <ul class="stats wrap" aria-label="OSSHunt in numbers">
        {[[d.counts.cats, 'categories'], [d.counts.paid, 'tools'], [d.counts.oss, 'solutions'], [d.counts.maps, 'alternatives']].map(([n, label], i) => (
          <li class="stat" style={`--i:${i}`}>
            <b class="num" data-to={n}>{n}</b>
            <span class="lab">{label}</span>
            <i class="bar" aria-hidden="true"></i>
          </li>
        ))}
      </ul>
    </div>
    </div>

    <Waitlist id="waitlist-home" />

    <section class="block wrap" aria-labelledby="price-h">
      <h2 id="price-h"><span>Entry prices, highest-reach categories first</span></h2>
      <ul class="prices">
        {d.prices.map((p) => (
          <li>
            <span class="pn">{p.name}</span>
            <span class="pv">{p.price}{p.yearly && <em>billed yearly</em>}</span>
            <a class="ps" href={`/software/${p.id}/`}>{p.alts} alternative{p.alts === 1 ? '' : 's'}</a>
          </li>
        ))}
      </ul>
      <p class="note">Lowest published per-seat price as checked on {CHECKED}; plans and minimums differ. Shown in the unit each vendor publishes, not converted. A price is not a cost comparison.</p>
    </section>

    <section class="block wrap" id="categories" aria-labelledby="cat-h">
      <h2 id="cat-h"><span>Browse by category</span><span class="meta">Ordered by editorial audience reach</span></h2>
      {d.groups.map((g) => (
        <details class="reach group" open>
          <summary><h3>{REACH[g.reach]}</h3></summary>
          <ul>
            {g.items.map((c) => <li><a href={`/categories/${c.id}/`}><span class="cname">{c.name}<span class="n">{c.paid} paid</span></span><span class="flow"><Avatars items={c.toolList} max={3} />{c.altList.length > 0 && <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-label="replaced by" role="img"><path d="M3 12h16M13 6l6 6-6 6" /></svg>}<Avatars items={c.altList} max={3} /></span></a></li>)}
          </ul>
        </details>
      ))}
    </section>
  </main>

</Page>

<style>

  .hero { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); gap: clamp(28px, 5vw, 72px); padding-block: clamp(32px, 5vw, 64px); align-items: center; }
  /* On wide screens the first screen fills the viewport below the header (72px = header incl. 8px rule): hero above, counts band at the bottom edge. */
  @media (min-width: 901px) { .first { display: flex; flex-direction: column; min-height: calc(100svh - 72px); } .first .hero { flex: 1; } }
  h1 { font-size: clamp(2.5rem, 5.6vw, 5rem); line-height: 0.96; font-family: var(--display); font-weight: 900; letter-spacing: -0.005em; margin-bottom: 28px; }
  .samples { display: flex; flex-wrap: nowrap; align-items: center; gap: 6px; margin-top: 14px; font-weight: 700; font-size: 0.8125rem; }
  .slabel { margin-right: 4px; flex: none; }
  /* As many logos as fit on one line; the rest are clipped (and skipped by the cycle). */
  .chips { display: flex; gap: 6px; flex: 1; min-width: 0; overflow: hidden; }
  .chip { flex: none; }
  /* Sample picker: tool logos in black and white; the selected (or hovered) one shows its colours. */
  .chip { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: none; padding: 0; cursor: pointer; text-decoration: none; }
  .chip:hover { background: none; }
  .chip img { width: 28px; height: 28px; object-fit: contain; display: block; filter: grayscale(1); opacity: 0.8; transition: filter 0.2s ease-out, opacity 0.2s ease-out; }
  .chip:hover img, .chip[data-on] img { filter: none; opacity: 1; }

  /* Counts band: heavy rule above, ruled cells, condensed numerals that count up when scrolled into view. */
  .stats-band { border-top: var(--rule-8) solid var(--ink); border-bottom: var(--rule-1) solid var(--ink); }
  .stats { list-style: none; margin-block: 0; padding-block: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stat { position: relative; display: grid; align-content: center; gap: 2px; padding: clamp(18px, 3vw, 32px) clamp(12px, 2vw, 28px); border-left: var(--rule-1) solid var(--ink); }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .num { font-family: var(--display); font-weight: 900; font-size: clamp(2.5rem, 5.4vw, 4.5rem); line-height: 1; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .lab { font-size: clamp(0.875rem, 1.3vw, 1.125rem); font-weight: 600; }
  .bar { display: block; height: 4px; width: 56px; margin-top: 10px; background: var(--band); transform-origin: left; }
  /* Armed by script: hidden until the band enters the view, then each cell rises in, staggered; the yellow bar draws. */
  [data-stats].armed .stat { opacity: 0; transform: translateY(14px); }
  [data-stats].armed .bar { transform: scaleX(0); }
  [data-stats].in .stat { opacity: 1; transform: none; transition: opacity 0.5s ease-out calc(var(--i) * 120ms), transform 0.5s ease-out calc(var(--i) * 120ms); }
  [data-stats].in .bar { transform: none; transition: transform 0.6s ease-out calc(var(--i) * 120ms + 250ms); }
  @media (prefers-reduced-motion: reduce) { [data-stats].armed .stat, [data-stats].in .stat, [data-stats].armed .bar, [data-stats].in .bar { opacity: 1; transform: none; transition: none; } }

  .block { padding-block: clamp(32px, 4vw, 56px) 0; }
  h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; font-size: 1.125rem; font-family: var(--display); font-weight: 900; text-transform: uppercase; letter-spacing: 0.02em; border-bottom: var(--rule-3) solid var(--ink); padding-bottom: 6px; margin-bottom: 4px; }
  h2 a, h2 .meta { font-size: 0.875rem; font-weight: 600; text-transform: none; letter-spacing: 0; }
  .prices { list-style: none; margin: 0; padding: 0; border: 3px solid var(--ink); }
  .prices li { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 2.4fr) 140px; /* fixed last column so every row's columns line up */ gap: 4px 16px; align-items: baseline; padding: 9px 14px; border-top: 1px solid var(--ink); }
  .prices li:first-child { border-top: 0; }
  /* The list is a closed 3px frame; the heading above it carries no rule of its own. */
  #price-h { border-bottom: 0; margin-bottom: 10px; }
  .pn { font-weight: 800; }
  .pv em { display: inline-block; margin-left: 8px; font-size: 0.75rem; font-style: italic; color: var(--ink-2); }
  .ps { font-size: 0.875rem; justify-self: end; }
  .note { font-size: 0.8125rem; color: var(--ink-2); margin: 10px 0 0; }

  .reach { margin-top: 20px; }
  .reach > summary { padding: 4px 0; margin-bottom: 6px; }
  h3 { font-size: 1.125rem; font-family: var(--display); font-weight: 900; text-transform: uppercase; letter-spacing: 0.02em; margin-bottom: 6px; }
  .reach ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); border-top: var(--rule-3) solid var(--ink); border-left: var(--rule-1) solid var(--ink); }
  .reach li { border-right: var(--rule-1) solid var(--ink); border-bottom: var(--rule-1) solid var(--ink); }
  .reach a { display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; text-decoration: none; font-weight: 600; height: 100%; }
  .cname { display: flex; justify-content: space-between; gap: 12px; }
  .cname > .n { font-weight: 600; font-size: 0.75rem; color: var(--ink-2); white-space: nowrap; align-self: baseline; }
  /* Fixed columns (tools | arrow | alternatives) so every card's arrow and second stack sit at the same x. */
  .flow { --av: 28px; --avp: 6px; --ov: 10px; --n: 3; --stack: calc(var(--av) * (var(--n) + 1) - var(--ov) * var(--n)); display: grid; grid-template-columns: var(--stack) 18px var(--stack); column-gap: 10px; align-items: center; margin-top: auto; min-height: 28px; }
  .flow .arrow { justify-self: center; }
  @media (max-width: 1360px) { .flow { --av: 24px; --avp: 5px; --ov: 9px; } }


  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { border-left: 0; padding-left: 0; }
    .stat:nth-child(n + 3) { border-top: var(--rule-1) solid var(--ink); }
    .prices li { grid-template-columns: minmax(0, 1fr) auto; }
    .pv { grid-column: 1; } .ps { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  }
</style>

<script>
  const band = document.querySelector<HTMLElement>('[data-stats]');
  if (band && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    band.classList.add('armed');
    const nums = [...band.querySelectorAll<HTMLElement>('.num')];
    const run = () => {
      band.classList.add('in');
      nums.forEach((el, i) => {
        const to = Number(el.dataset.to); const delay = i * 120; const dur = 1100;
        const t0 = performance.now() + delay;
        el.textContent = '0';
        const tick = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - t0) / dur));
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); run(); }
    }, { threshold: 0.4 });
    io.observe(band);
  }
</script>
