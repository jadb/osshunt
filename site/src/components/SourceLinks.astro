---
import Icon from './Icon.astro';
import { sourceLinks } from '../lib/links';
interface Props { url?: string; repo?: string; name: string }
const { url, repo, name } = Astro.props;
const l = sourceLinks(url, repo);
const HOST = { github: 'GitHub', gitlab: 'GitLab', code: 'Source code' } as const;
---
{(l.website || l.repo) && (
  <span class="slinks">
    {l.website && <a href={l.website} rel="noopener" aria-label={`${name} website`}><Icon name="globe" size={20} /></a>}
    {l.repo && l.host && (
      <a href={l.repo} rel="noopener" aria-label={`${name} on ${HOST[l.host]}`}>
        {l.host === 'code' ? <Icon name="code" size={20} /> : <span class="mk" style={`--m:url(/logos/host-${l.host}.svg)`} />}
      </a>
    )}
  </span>
)}
