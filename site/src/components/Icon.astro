  mail: 'M3 5h18v14H3zM3 6l9 7 9-7',
  bucket: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6l2 14h12l2-14',
