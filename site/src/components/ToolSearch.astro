---
interface Props { tools: { id: string; name: string }[] }
const { tools } = Astro.props;
---
<form class="search" role="search" action="#categories" data-search>
  <label class="sr" for="tool-q">Search a paid tool</label>
  <input id="tool-q" name="q" type="search" autocomplete="off" placeholder="Search a paid tool, e.g. Slack" role="combobox" aria-expanded="false" aria-controls="tool-list" aria-autocomplete="list" />
  <button type="submit">Find</button>
  <ul id="tool-list" role="listbox" hidden></ul>
  <p id="tool-msg" class="msg" role="status" hidden>No paid tool matches. <a href="#categories">Browse by category</a></p>
  <script type="application/json" id="tool-data" set:html={JSON.stringify(tools)} />
</form>

<style>
  .search { position: relative; display: grid; grid-template-columns: 1fr auto; border: 4px solid var(--ink); background: var(--paper); }
  input { font: 500 clamp(1.125rem, 2vw, 1.5rem)/1.2 'Archivo', sans-serif; padding: 18px 18px; border: 0; background: transparent; color: var(--ink); min-width: 0; border-radius: 0; }
  input::placeholder { color: var(--ink-2); opacity: 1; }
  input:focus-visible { outline: none; box-shadow: none; }
  .search:focus-within { box-shadow: 0 0 0 6px var(--band); }
  button { font: 800 1.125rem/1 'Archivo', sans-serif; background: var(--band); color: var(--ink); border: 0; border-left: 4px solid var(--ink); padding: 0 clamp(18px, 3vw, 36px); cursor: pointer; border-radius: 0; }
  button:hover { background: var(--ink); color: var(--band); }
  ul { position: absolute; z-index: 5; inset: calc(100% + 4px) -4px auto -4px; margin: 0; padding: 0; list-style: none; background: var(--paper); border: 4px solid var(--ink); max-height: 340px; overflow: auto; }
  li { padding: 12px 18px; border-bottom: 1px solid var(--ink); cursor: pointer; font-weight: 600; }
  li:last-child { border-bottom: 0; }
  li[aria-selected='true'], li:hover { background: var(--band); }
  .msg { grid-column: 1 / -1; margin: 0; padding: 10px 18px; border-top: 1px solid var(--ink); font-size: 0.9375rem; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-search]');
  if (form) {
    const tools: { id: string; name: string }[] = JSON.parse(document.getElementById('tool-data')!.textContent!);
    const input = form.querySelector('input')!;
    const list = form.querySelector<HTMLUListElement>('#tool-list')!;
    const msg = form.querySelector<HTMLElement>('#tool-msg')!;
    let hits: typeof tools = [];
    let sel = -1;
    const go = (id: string) => { location.href = `/software/${id}/`; };
    const paint = () => {
      list.replaceChildren(...hits.map((t, i) => {
        const li = document.createElement('li');
        li.id = `tool-${t.id}`; li.role = 'option'; li.textContent = t.name;
        li.setAttribute('aria-selected', String(i === sel));
        li.addEventListener('mousedown', (e) => { e.preventDefault(); go(t.id); });
        return li;
      }));
      list.hidden = !hits.length;
      input.setAttribute('aria-expanded', String(!!hits.length));
      if (sel >= 0) input.setAttribute('aria-activedescendant', `tool-${hits[sel].id}`); else input.removeAttribute('aria-activedescendant');
    };
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      hits = q ? tools.filter((t) => t.name.toLowerCase().includes(q)).slice(0, 8) : [];
      sel = -1; msg.hidden = !(q && !hits.length); paint();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && hits.length) { e.preventDefault(); sel = (sel + 1) % hits.length; paint(); }
      else if (e.key === 'ArrowUp' && hits.length) { e.preventDefault(); sel = (sel - 1 + hits.length) % hits.length; paint(); }
      else if (e.key === 'Escape') { hits = []; sel = -1; paint(); }
    });
    input.addEventListener('blur', () => { hits = []; sel = -1; paint(); });
    form.addEventListener('submit', (e) => {
      const pick = hits[Math.max(sel, 0)];
      if (pick) { e.preventDefault(); go(pick.id); }
      else if (input.value.trim()) { e.preventDefault(); input.dispatchEvent(new Event('input')); }
    });
  }
</script>
