---
import FactsLabel from './FactsLabel.astro';
import { type homeData } from '../lib/home';
interface Props { scenes: Awaited<ReturnType<typeof homeData>>['scenes'] }
const { scenes } = Astro.props;
---
<div class="hero-loop">
<div class="loop" data-loop role="group" aria-roledescription="carousel" aria-live="off" aria-label="Examples of paid tools and their open-source alternatives">
  {scenes.flatMap((s, si) => s.pages.flat().map((alt, ai) => (
    <section class:list={['view', { on: si === 0 && ai === 0 }]} data-scene={si} data-alt={ai} aria-label={`${s.name}, alternative ${ai + 1} of ${s.total}: ${alt.name}`} aria-hidden={si === 0 && ai === 0 ? 'false' : 'true'}>
      <div class="inc">
        <span class="tile">{s.logo && <img src={`/logos/${s.logo}.svg`} alt="" width="56" height="56" />}</span>
        <p class="inc-text"><b data-fx>{s.name}</b><span data-fx>Entry price {s.price}</span></p>
      </div>
      <FactsLabel {...alt} incumbent={s.name} />
      <div class="progress" aria-hidden="true"><span></span></div>
    </section>
  )))}
</div>
</div>

<style>
  /* All views share one grid cell so the hero keeps the height of the tallest one. */
  .loop { display: grid; }
  /* The sheet frame stays put: views swap instantly and only their content changes (text scrambles in, icons fade in). */
  .view { grid-area: 1 / 1; align-self: start; visibility: hidden; }
  .view.on { visibility: visible; }
  .view.fx .facts-row > :last-child, .view.fx .slinks, .view.fxtool .tile img { animation: fxin 0.35s ease-out both; }
  @keyframes fxin { from { opacity: 0; } to { opacity: 1; } }
  /* Fills over the 10s each sheet stays (driven by the same clock as the swap); a full bar brings in the next sheet. */
  .progress { height: 3px; margin-top: 0; }
  .progress span { display: block; height: 100%; width: 0; background: var(--band); }
  .progress span { transition: width 0.1s linear; }
  .hero-loop.off .progress { visibility: hidden; }
  .inc { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .tile { width: 76px; height: 76px; display: grid; place-items: center; flex: none; }
  .tile img { width: 56px; height: 56px; object-fit: contain; }
  .inc-text { margin: 0; display: grid; font-size: 0.9375rem; }
  .inc-text b { font-size: 1.5rem; font-family: var(--display); font-weight: 900; line-height: 1.1; }
  @media (prefers-reduced-motion: reduce) { .view.fx .facts-row > :last-child, .view.fx .slinks, .view.fxtool .tile img { animation: none; } .progress { visibility: hidden; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-loop]');
  const wrap = document.querySelector<HTMLElement>('.hero-loop');
  if (root && wrap) {
    const views = [...root.querySelectorAll<HTMLElement>('.view')];
    const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-chip]')];
    const strip = document.querySelector<HTMLElement>('[data-chips]');
    let limit = chips.length; // how many sample logos fit on the line; the cycle only visits those
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    // The bar lives inside each sheet's view, so it always sits right under the sheet shown.
    const fillOf = (v?: HTMLElement) => v?.querySelector<HTMLElement>('.progress span') ?? null;
    const SHOW = 10000, TICK = 100;
    const POOL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789#%&*+?';
    // Letters mix: each character cycles through random glyphs, then settles left to right.
    const scramble = (el: HTMLElement) => {
      const final = el.dataset.final ?? (el.dataset.final = el.textContent ?? '');
      const total = 650, started = performance.now();
      const id = String((Number(el.dataset.fxId) || 0) + 1); el.dataset.fxId = id;
      const run = (now: number) => {
        if (el.dataset.fxId !== id) return;
        const t = (now - started) / total;
        if (t >= 1) { el.textContent = final; return; }
        el.textContent = [...final].map((ch, i) => (ch === ' ' || t > (i / final.length) * 0.75 + 0.25 ? ch : POOL[Math.floor(Math.random() * POOL.length)])).join('');
        requestAnimationFrame(run);
      };
      requestAnimationFrame(run);
    };
    const count = (sc: number) => views.filter((v) => Number(v.dataset.scene) === sc).length;
    let scene = 0, alt = 0, elapsed = 0, stopped = false, hold = false;
    let prev: HTMLElement | undefined;
    const paint = () => { const f = fillOf(views.find((v) => v.classList.contains('on'))); if (f) f.style.width = `${Math.min(100, (elapsed / SHOW) * 100)}%`; };
    const show = (sc: number, al: number) => {
      prev = views.find((v) => v.classList.contains('on'));
      scene = (sc + limit) % limit; alt = al; elapsed = 0;
      views.forEach((v) => {
        const on = Number(v.dataset.scene) === scene && Number(v.dataset.alt) === alt;
        v.classList.toggle('on', on); v.setAttribute('aria-hidden', String(!on));
      });
      chips.forEach((c, n) => c.toggleAttribute('data-on', n === scene));
      const cur = views.find((v) => v.classList.contains('on'));
      if (cur && !still.matches) {
        const toolChanged = !prev || Number(prev.dataset.scene) !== scene; // the tool's logo only fades in when the tool changes
        cur.classList.remove('fx', 'fxtool'); void cur.offsetWidth; cur.classList.add('fx'); if (toolChanged) cur.classList.add('fxtool');
        // Only text that differs from the sheet being replaced is mixed.
        const before = prev ? [...prev.querySelectorAll<HTMLElement>('[data-fx]')].map((e) => e.dataset.final ?? e.textContent) : [];
        cur.querySelectorAll<HTMLElement>('[data-fx]').forEach((e, k) => {
          const text = e.dataset.final ?? e.textContent ?? '';
          if (!prev || before[k] !== text) scramble(e); else e.textContent = text; // unchanged: never touched
        });
        window.setTimeout(() => cur.classList.remove('fx', 'fxtool'), 400);
      }
      const f = fillOf(cur ?? undefined) ?? fillOf(views.find((v) => v.classList.contains('on')));
      views.forEach((v) => { const x = fillOf(v); if (x && v !== (cur ?? v)) x.style.width = '0%'; });
      if (f) { f.style.transition = 'none'; paint(); void f.offsetWidth; f.style.transition = ''; }
    };
    // One sheet at a time: next alternative of this tool, then the next tool.
    const advance = () => (alt + 1 < count(scene) ? show(scene, alt + 1) : show(scene + 1, 0));
    const measure = () => {
      if (!strip) return;
      const edge = strip.getBoundingClientRect().right;
      limit = Math.max(1, chips.filter((c) => c.getBoundingClientRect().right <= edge + 0.5).length);
      chips.forEach((c, n) => { const out = n >= limit; c.toggleAttribute('inert', out); c.setAttribute('aria-hidden', String(out)); });
      if (scene >= limit) show(0, 0);
    };
    if (strip) { new ResizeObserver(measure).observe(strip); measure(); }
    // Runs until the first click, key press or focus anywhere; hover pauses it.
    const stop = () => { stopped = true; window.clearInterval(timer); wrap.classList.add('off'); };
    const timer = window.setInterval(() => {
      if (hold || stopped) return;
      elapsed += TICK; paint();
      if (elapsed >= SHOW) advance();
    }, TICK);
    if (still.matches) stop();
    // A sample logo is a link to that tool's page (the same place a search for it goes); hover or focus previews its sheet here.
    chips.forEach((c, n) => { c.addEventListener('pointerenter', () => show(n, 0)); c.addEventListener('focus', () => show(n, 0)); });
    document.addEventListener('click', stop, { once: true, capture: true });
    document.addEventListener('keydown', stop, { once: true, capture: true });
    document.addEventListener('focusin', stop, { once: true });
    root.addEventListener('pointerenter', () => { hold = true; });
    root.addEventListener('pointerleave', () => { hold = false; });
  }
</script>
