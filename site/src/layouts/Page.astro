---
import { slotPrice, OPEN_SLOTS } from '../lib/sponsorship';
import Base from './Base.astro';
import { CHECKED } from '../lib/home';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href="/">OSSHunt</a>
      <nav aria-label="Primary">
        <a href="/software/">Software</a><a href="/categories/">Categories</a><a href="/alternatives/">Alternatives</a>
      </nav>
      <div class="backed hb">
        <span>Our sponsors</span>
        <a href="https://ideacrafters.com"><img src="/logos/idea-crafters.jpg" alt="Idea Crafters" width="32" height="32" /></a>
        <a href="https://lesexperts.ai"><img src="/logos/les-experts-ai.jpg" alt="Les Experts AI" width="32" height="32" /></a>
        {Array.from({ length: OPEN_SLOTS }, (_, i) => (
          <a class="slot" href="/sponsor/" aria-label={`Open sponsor slot ${i + 1}, $${slotPrice(i + 1)} per month`} title={`Sponsor OSSHunt, $${slotPrice(i + 1)} / month`}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M12 4v16M4 12h16" /></svg>
          </a>
        ))}
      </div>
    </div>
  </header>
  <slot />
  <footer class="foot">
    <div class="wrap">
      <div class="foot-row">
        <p class="copy">© {new Date().getFullYear()} Idea Crafters LLC</p>
        <nav class="legal" aria-label="Legal"><a href="/privacy/">Privacy policy</a><a href="/terms/">Terms of service</a></nav>
        <p class="checked-foot">Checked {CHECKED}</p>
      </div>
      <p>Fit is not feature parity. Unknown means unverified. Logos belong to their owners and appear only to identify the products.</p>
    </div>
  </footer>
</Base>

<style is:global>
  .top { border-bottom: var(--rule-8) solid var(--ink); }
  .bar { display: flex; align-items: center; gap: 24px 32px; flex-wrap: wrap; padding-block: 14px; }
  .brand { font-size: 1.5rem; font-family: var(--display); font-weight: 900; text-decoration: none; }
  nav { display: flex; gap: 6px 22px; flex-wrap: wrap; font-weight: 600; }
  nav a { text-decoration: none; padding: 4px 0; }
  nav a:hover { text-decoration: underline; }
  .foot { margin-top: clamp(40px, 6vw, 80px); border-top: var(--rule-8) solid var(--ink); padding-block: 22px 40px; }
  .foot-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 28px; }
  .foot .foot-row .copy, .foot .foot-row .checked-foot { line-height: 1.45; }
  .foot .foot-row .copy { margin: 0; font-size: 0.875rem; font-weight: 600; color: var(--ink); max-width: none; }
  .legal { display: flex; gap: 20px; font-size: 0.875rem; font-weight: 600; }
  .foot .foot-row .checked-foot { margin: 0 0 0 auto; font-size: 0.875rem; font-weight: 400; color: var(--ink); }
  .hb { margin-left: auto; }
  .backed { margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; font-size: 0.875rem; }
  .backed > span { color: var(--ink-2); }
  .backed a { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none; }
  .backed a:hover { text-decoration: underline; background: none; }
  .backed .slot { width: 32px; height: 32px; justify-content: center; border: 2px dashed var(--ink-2); color: var(--ink-2); }
  .backed .slot:hover { border-color: var(--ink); color: var(--ink); background: var(--band); }
  .backed img { width: 32px; height: 32px; display: block; }
  .foot p { margin: 14px 0 0; font-size: 0.8125rem; color: var(--ink-2); }

  @media (max-width: 900px) { .hb { margin-left: 0; } }
</style>
