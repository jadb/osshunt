{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "osshunt",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "osshunt.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
