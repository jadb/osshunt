{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "osshunt",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/badge/*"]
  },
  "routes": [
    {
      "pattern": "osshunt.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
