            "patch": "@@ -4436,6 +4436,7 @@\n   \"location_applied_to_hosts_other\": \"Konum {{count}} ev sahibine uyguland\u0131\",\n   \"booking_audit_action\": {\n     \"created\": \"{{host}} ile rezerve edildi\",\n+    \"created_awaiting_host\": \"Rezervasyon yap\u0131ld\u0131 (ev sahibi bekleniyor)\",\n     \"created_with_seat\": \"{{host}} ile koltuk rezerve edildi\",\n     \"cancelled\": \"\u0130ptal edildi\",\n     \"rescheduled\": \"Yeniden planland\u0131 {{oldDate}} -> <0>{{newDate}}</0>\",\n@@ -4730,5 +4731,46 @@\n   \"dashboard\": \"kontrol paneli\",\n   \"paypal_webhook_reminder\": \"Entegrasyonumuz, i\u015flemlerin sistemimize geri bildirilmesi i\u00e7in kulland\u0131\u011f\u0131m\u0131z PayPal hesab\u0131n\u0131zda belirli bir webhook olu\u015fturur. Bu webhook'u silerseniz, geri bildirim yapamay\u0131z ve bunun d\u00fczg\u00fcn \u00e7al\u0131\u015fmas\u0131 i\u00e7in uygulamay\u0131 tekrar kald\u0131r\u0131p y\u00fcklemeniz gerekir. Uygulamay\u0131 kald\u0131rmak mevcut etkinlik t\u00fcr\u00fc fiyat/para birimi yap\u0131land\u0131rman\u0131z\u0131 silmez ancak rezervasyon alamayacaks\u0131n\u0131z.\",\n   \"discount_25\": \"-%25\",\n+  \"test_notification_title\": \"Test bildirimi\",\n+  \"test_notification_body\": \"Anl\u0131k bildirimler ba\u015far\u0131yla etkinle\u015ftirildi\",\n+  \"password_complexity_requirement\": \"Bir rakam, b\u00fcy\u00fck ve k\u00fc\u00e7\u00fck harf i\u00e7ermelidir\",\n+  \"avatar_of_name\": \"{{name}} kullan\u0131c\u0131s\u0131n\u0131n avatar\u0131\",\n+  \"app_icon\": \"{{app}} uygulama simgesi\",\n+  \"two_factor_auth_qr_code\": \"\u0130ki fakt\u00f6rl\u00fc kimlik do\u011frulama QR kodu\",\n+  \"label_cannot_be_whitespace\": \"Etiket yaln\u0131zca bo\u015fluklardan olu\u015famaz\",\n+  \"migrations\": \"Ge\u00e7i\u015fler\",\n+  \"organization_migration_move_team\": \"Ekibi organizasyona ta\u015f\u0131\",\n+  \"organization_migration_move_team_description\": \"Mevcut normal bir ekibi yeni bir slug ile organizasyona