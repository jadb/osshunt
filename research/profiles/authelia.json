  "productReasons": [
    {
      "claim": "Reverse-proxy authentication extends a central login portal to web applications without their own SSO integration.",
      "basis": "assessment",
      "sources": [
        "https://www.authelia.com/overview/prologue/architecture/"
      ]
    },
    {
      "claim": "Several second-factor methods and device-registration identity checks cover varied authentication workflows.",
      "basis": "assessment",
      "sources": [
        "https://www.authelia.com/overview/prologue/introduction/"
      ]
    },
    {
      "claim": "OIDC and trusted-header SSO connect both standards-aware applications and proxy-protected sites.",
      "basis": "assessment",
      "sources": [
