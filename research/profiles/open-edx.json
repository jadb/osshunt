    "selfHosting": {
      "mode": "server",
      "requirements": [
        {
          "component": "Docker24.0.5+ and Compose2+",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Official Tutor deployment;64-bit UNIX host,AMD64/ARM64;Python3.9+ only if installing Tutor through pip rather than binary.",
          "sources": [
            "https://docs.tutor.edly.io/en/latest/install.html"
          ]
        },
        {
          "component": "MySQL8.4",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Default SQL service; current release template pins8.4.11. Can be externally managed; disabling local container does not remove SQL dependency.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/config/defaults.yml"
          ]
        },
        {
          "component": "MongoDB7",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Default document store; template7.0.39. External service alternative possible; local container toggle does not mean optional application data.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/config/defaults.yml"
          ]
        },
        {
          "component": "Redis7",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Default caching/Celery broker; template7.4.10. Not RabbitMQ by default.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/config/defaults.yml"
          ]
        },
        {
          "component": "Meilisearch",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Default search backend; template1.36.0. Do not substitute older Elasticsearch stack from stale deployment guides.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/config/defaults.yml"
          ]
        },
        {
          "component": "LMS and CMS application containers and Celery workers",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Python/Django application packaged in official images; production workers handle asynchronous jobs.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/local/docker-compose.prod.yml"
          ]
        },
        {
          "component": "Caddy HTTPS reverse proxy",
          "necessity": "conditional",
          "group": null,
          "condition": "Default production exposure",
          "notes": "Bundled proxy; own reverse proxy/load balancer can replace it with configuration.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/local/docker-compose.prod.yml"
          ]
        },
        {
          "component": "SMTP relay",
          "necessity": "conditional",
          "group": null,
          "condition": "Delivering enrollment/reset/notification email",
          "notes": "Bundled Exim relay configured by default; external SMTP service alternative.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/local/docker-compose.yml"
          ]
        },
        {
          "component": "Persistent local database/media volumes",
          "necessity": "required",
          "group": null,
          "condition": "Always",
          "notes": "Default local storage; object-storage integrations need separate credentials/services if selected.",
          "sources": [
            "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/local/docker-compose.yml"
          ]
        },
        {
          "component": "Kubernetes",
          "necessity": "conditional",
          "group": null,
          "condition": "tutor k8s deployment route",
          "notes": "Not required for single-server tutor local route. Optional plugins can add services; requirements cover release baseline.",
          "sources": [
            "https://docs.tutor.edly.io/en/latest/install.html"
          ]
        }
      ],
      "resources": {
        "cpu": "2CPU minimum;4CPU recommended",
        "memory": "4GB minimum;8GB recommended",
        "storage": "8GB minimum;25GB recommended",
        "os": "64-bit UNIX (Linux/macOS); WindowsWSL2 reported;AMD64/ARM64",
        "notes": "Only explicit documented hardware figures included; null means no minimum verified in reviewed installation source.",
        "sources": [
          "https://docs.tutor.edly.io/en/latest/install.html"
        ]
      },
      "notes": "Officially recommended Tutor release/verawood.1 deployment. Native application is Python/Django, packaged in containers. SQL+document+cache/broker+search services required by default; production Celery workers included. External services may replace local containers. Default volumes local;S3 optional integration, not mandatory.",
      "sources": [
        "https://docs.tutor.edly.io/en/latest/install.html",
        "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/config/defaults.yml",
        "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/local/docker-compose.yml",
        "https://raw.githubusercontent.com/overhangio/tutor/release/tutor/templates/local/docker-compose.prod.yml"
      ]
