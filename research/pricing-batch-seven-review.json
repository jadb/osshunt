        },
        {
          "fact": "Self-hosted applications with external-user pricing require a custom annual plan; Cloud bands not transferred to self-hosted deployments.",
          "source": {
            "locator": "offset:202727-202981",
            "text": "Deploy branded customer-facing portals with built-in user management and permissions. Applications with external user pricing require a custom annual plan for self-hosted deployments",
            "url": "https://retool.com/pricing",
            "capturedAt": "2025-06-20T03:56:49.000Z",
            "sha256": "413023cf2f8314f038bf128c6f5e7ce47a0d652c3a50a2e94a2e126abdfbaf1b"
          }
        },
        {
          "fact": "Students and educators can apply for a free Business account; non-profits can apply for25free seats. Conditional offers, not a generally free paid tier.",
          "source": {
            "locator": "offset:369067-370201",
            "text": "Students and educators: Complete a student and educators application ↗ to claim a free Business account. Nonprofits: Complete a nonprofits application ↗ to claim 25 free seats.",
            "url": "https://retool.com/pricing",
            "capturedAt": "2025-06-20T03:56:49.000Z",
            "sha256": "413023cf2f8314f038bf128c6f5e7ce47a0d652c3a50a2e94a2e126abdfbaf1b"
          }
        },
        {
          "fact": "Agents additional capacity available in paid tiers, but no supported numerical capacity rate recovered.",
          "source": {
            "locator": "offset:270545-271519",
            "text": "Up to 20/month Additional capacity is available in Team, Business, or Enterprise plans.",
